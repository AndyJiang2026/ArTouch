# ArtTouch NFC System Environment Variables

# =============================================================================
# Application Settings
# =============================================================================

# Application name (default: ArtTouch NFC System)
# APP_NAME=ArtTouch NFC System

# Application version (default: 1.0.0)
# APP_VERSION=1.0.0

# Debug mode (default: false)
# DEBUG=false

# =============================================================================
# Security Settings
# =============================================================================

# Secret key for JWT token generation
# IMPORTANT: Generate a secure key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# JWT algorithm (default: HS256)
# ALGORITHM=HS256

# Access token expiration in hours (default: 24)
# ACCESS_TOKEN_EXPIRE_HOURS=24

# =============================================================================
# Database Settings
# =============================================================================

# Database connection URL
# SQLite (default for development):
# DATABASE_URL=sqlite:///./data/artouch.db
# PostgreSQL (recommended for production):
# DATABASE_URL=postgresql://user:password@localhost:5432/artouch
DATABASE_URL=

# PostgreSQL password (REQUIRED for production with PostgreSQL)
# Generate a secure password with: python -c "import secrets; print(secrets.token_urlsafe(16))"
POSTGRES_PASSWORD=

# =============================================================================
# File Storage Settings
# =============================================================================

# Base directory for application files (auto-detected)
# BASE_DIR=/path/to/artouch/backend

# Video storage directory (relative to BASE_DIR)
# VIDEO_DIR=./videos

# Data directory (relative to BASE_DIR)
# DATA_DIR=./data

# Maximum video file size in bytes (default: 200MB)
# MAX_VIDEO_SIZE=209715200

# Allowed video MIME types (comma-separated)
# ALLOWED_VIDEO_TYPES=video/mp4,video/mpeg,video/quicktime

# =============================================================================
# NFC Settings
# =============================================================================

# Base URL for NFC tag interaction pages
# This is the URL that NFC tags will redirect users to
NFC_BASE_URL=https://www.qiangguoshijie.com.cn/nfc

# =============================================================================
# CORS Settings (configured in main.py)
# =============================================================================

# Allowed origins for CORS (configured in app/main.py)
# ALLOWED_ORIGINS=https://www.qiangguoshijie.com.cn,https://qiangguoshijie.com.cn
